{
  "name": "codex-branch-map",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.8.1",
  "publisher": "pth-viewer",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/yueduduo/codex-session-tree.git" },
  "homepage": "https://github.com/yueduduo/codex-session-tree#readme",
  "bugs": { "url": "https://github.com/yueduduo/codex-session-tree/issues" },
  "icon": "assets/marketplace-icon.png",
  "galleryBanner": { "color": "#212121", "theme": "dark" },
  "keywords": ["codex", "session", "conversation", "branch", "history"],
  "files": ["src", "webview", "assets", "skills", "README.md", "README.zh-CN.md", "CHANGELOG.md", "LICENSE", "package.nls.json", "package.nls.zh-cn.json"],
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Other"],
  "main": "./src/extension.js",
  "activationEvents": ["onView:codexSessionTree.sessions"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "codexSessionTree", "title": "%viewContainer.title%", "icon": "assets/activity-bar.svg" }
      ]
    },
    "views": {
      "codexSessionTree": [
        { "id": "codexSessionTree.sessions", "name": "%view.sessions%", "type": "webview", "icon": "assets/activity-bar.svg" }
      ]
    },
    "commands": [
      { "command": "codexSessionTree.refresh", "title": "%command.refresh%", "icon": "$(refresh)" },
      { "command": "codexSessionTree.open", "title": "%command.open%" }
    ],
    "menus": {
      "view/title": [
        { "command": "codexSessionTree.refresh", "when": "view == codexSessionTree.sessions", "group": "navigation" }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "codexSessionTree.codexPath": {
          "type": "string",
          "default": "",
          "description": "%config.codexPath%"
        },
        "codexSessionTree.showArchived": {
          "type": "boolean",
          "default": false,
          "description": "%config.showArchived%"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test",
    "package": "node scripts/package.js"
  }
}
